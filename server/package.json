{
  "name": "jat-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "rm -rf build && tsc",
    "dev": "dotenvx run -- cross-env NODE_ENV=development ts-node-dev src/index.ts",
    "build:server": "npm run compile && npm run tsc",
    "build:client": "rm -rf dist && cd ../client/ && npm install && npm run build && cp -r dist ../server/",
    "build:full": "npm run build:server && npm run build:client",
    "start": "dotenvx run -- cross-env NODE_ENV=production node build/src/index.js",
    "lint": "eslint .",
    "prettier": "npx prettier --write .",
    "compile": "graphql-codegen"
  },
  "author": "Garrett Chen",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@dotenvx/dotenvx": "^1.48.4",
    "@graphql-tools/schema": "^10.0.25",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "express": "^5.1.0",
    "googleapis": "^154.1.0",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0",
    "nodemailer": "^7.0.5",
    "ws": "^8.18.3",
    "zod": "^4.0.14"
  }
}
