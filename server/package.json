{
  "name": "jat-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "tsc": "rm -rf build && tsc",
    "dev": "dotenvx run -- cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "build:server": "npm run compile && npm run tsc",
    "build:client": "rm -rf dist && cd ../client/ && npm install && npm run build && cp -r dist ../server/",
    "build:full": "npm run build:server && npm run build:client",
    "start": "dotenvx run -- cross-env NODE_ENV=production node build/src/index.js",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "prettier": "npx prettier --write .",
    "compile": "graphql-codegen-esm --config codegen.ts && sed -i 's/\\/types/\\/types.js/g' ./src/__generated__/resolvers-types.ts"
  },
  "author": "Garrett Chen",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@dotenvx/dotenvx": "^2.38.2",
    "@graphql-tools/schema": "^10.0.36",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "googleapis": "^173.0.0",
    "graphql": "^16.15.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0",
    "nodemailer": "^9.0.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  }
}
